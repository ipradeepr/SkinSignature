# Environment Variables

# Preferred backend base URL used by frontend API helpers.
# Local dev example:
VITE_API_BASE=http://localhost:3001

# Production example:
# VITE_API_BASE=https://your-backend-url.onrender.com

# Backward-compatible alias (optional). If both are set, VITE_API_BASE wins.
# VITE_API_URL=https://your-backend-url.onrender.com
